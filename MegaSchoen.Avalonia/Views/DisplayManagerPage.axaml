<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MegaSchoen.Avalonia.ViewModels"
             x:Class="MegaSchoen.Avalonia.Views.DisplayManagerPage"
             x:DataType="vm:DisplayManagerViewModel">
    <ScrollViewer>
        <StackPanel Margin="20" Spacing="16">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Text="Display Manager"
                               FontSize="24"
                               FontWeight="Bold"/>
                    <TextBlock Text="Save and restore complete Windows display arrangements."
                               Foreground="Gray"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        VerticalAlignment="Center"/>
            </Grid>

            <ProgressBar IsIndeterminate="True"
                         IsVisible="{Binding IsBusy}"
                         Height="3"/>

            <Border IsVisible="{Binding HasStatus}"
                    Padding="10"
                    BorderBrush="#40808080"
                    BorderThickness="1"
                    CornerRadius="5">
                <TextBlock Text="{Binding StatusMessage}"
                           TextWrapping="Wrap"/>
            </Border>

            <Border Padding="14"
                    BorderBrush="#40808080"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Current displays"
                                   FontSize="18"
                                   FontWeight="Bold"/>
                        <CheckBox Grid.Column="1"
                                  Content="Hide inactive"
                                  IsChecked="{Binding HideInactiveDisplays}"/>
                    </Grid>

                    <TextBlock Text="No displays detected."
                               IsVisible="{Binding HasNoDisplays}"
                               Foreground="Gray"
                               HorizontalAlignment="Center"
                               Margin="10"/>

                    <ItemsControl ItemsSource="{Binding CurrentDisplays}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DisplayCardViewModel">
                                <Border Margin="0,3"
                                        Padding="10"
                                        BorderBrush="#30808080"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="3">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding MonitorName}"
                                                           FontWeight="Bold"/>
                                                <TextBlock Text="PRIMARY"
                                                           IsVisible="{Binding IsPrimary}"
                                                           Foreground="#4F8EF7"
                                                           FontSize="11"
                                                           FontWeight="Bold"/>
                                                <TextBlock Text="ACTIVE"
                                                           IsVisible="{Binding IsActive}"
                                                           Foreground="#43A047"
                                                           FontSize="11"
                                                           FontWeight="Bold"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding DeviceName}"
                                                       Foreground="Gray"
                                                       FontSize="11"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ModeText}"
                                                   Foreground="Gray"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Padding="14"
                    BorderBrush="#40808080"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel Spacing="10">
                    <TextBlock Text="Save current arrangement"
                               FontSize="18"
                               FontWeight="Bold"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox PlaceholderText="Profile name"
                                 Text="{Binding NewProfileName}"/>
                        <Button Grid.Column="1"
                                Content="Save"
                                Command="{Binding SaveCurrentArrangementCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Padding="14"
                    BorderBrush="#40808080"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel Spacing="10">
                    <TextBlock Text="Saved profiles"
                               FontSize="18"
                               FontWeight="Bold"/>

                    <TextBlock Text="No saved profiles yet."
                               IsVisible="{Binding HasNoProfiles}"
                               Foreground="Gray"
                               HorizontalAlignment="Center"
                               Margin="10"/>

                    <ItemsControl ItemsSource="{Binding SavedProfiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DisplayProfileCardViewModel">
                                <Border Margin="0,4"
                                        Padding="12"
                                        BorderBrush="#40808080"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <StackPanel Spacing="9">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="16"
                                                           FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Description}"
                                                           IsVisible="{Binding HasDescription}"
                                                           Foreground="Gray"
                                                           FontSize="12"/>
                                                <TextBlock FontSize="11" Foreground="Gray">
                                                    <Run Text="{Binding DisplayCount}"/>
                                                    <Run Text=" displays · Created "/>
                                                    <Run Text="{Binding CreatedLocal, StringFormat={}{0:g}}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <WrapPanel Grid.Column="1"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center">
                                                <Button Content="{Binding HotkeyButtonText}"
                                                        Command="{Binding $parent[UserControl].((vm:DisplayManagerViewModel)DataContext).BeginHotkeyCaptureCommand}"
                                                        CommandParameter="{Binding}"
                                                        KeyDown="OnHotkeyKeyDown"
                                                        ToolTip.Tip="Click, then press the shortcut"/>
                                                <Button Content="Clear hotkey"
                                                        IsVisible="{Binding HasHotkey}"
                                                        Command="{Binding $parent[UserControl].((vm:DisplayManagerViewModel)DataContext).ClearHotkeyCommand}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="Apply"
                                                        Command="{Binding $parent[UserControl].((vm:DisplayManagerViewModel)DataContext).ApplyProfileCommand}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Content="Overwrite"
                                                        Command="{Binding $parent[UserControl].((vm:DisplayManagerViewModel)DataContext).RequestOverwriteCommand}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="Replace with the current display arrangement"/>
                                                <Button Content="Delete"
                                                        Command="{Binding $parent[UserControl].((vm:DisplayManagerViewModel)DataContext).RequestDeleteCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </WrapPanel>
                                        </Grid>

                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="8"
                                                    IsVisible="{Binding IsOverwriteConfirmationVisible}">
                                            <TextBlock Text="Overwrite this profile with the current arrangement?"
                                                       VerticalAlignment="Center"/>
                                            <Button Content="Overwrite"
                                                    Command="{Binding $parent[UserControl].((vm:DisplayManagerViewModel)DataContext).ConfirmOverwriteCommand}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="Cancel"
                                                    Command="{Binding $parent[UserControl].((vm:DisplayManagerViewModel)DataContext).CancelPendingCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="8"
                                                    IsVisible="{Binding IsDeleteConfirmationVisible}">
                                            <TextBlock Text="Delete this profile?"
                                                       VerticalAlignment="Center"/>
                                            <Button Content="Delete"
                                                    Command="{Binding $parent[UserControl].((vm:DisplayManagerViewModel)DataContext).ConfirmDeleteCommand}"
                                                    CommandParameter="{Binding}"/>
                                            <Button Content="Cancel"
                                                    Command="{Binding $parent[UserControl].((vm:DisplayManagerViewModel)DataContext).CancelPendingCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
