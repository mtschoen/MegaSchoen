<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MegaSchoen.Avalonia.ViewModels"
        xmlns:views="using:MegaSchoen.Avalonia.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        x:Class="MegaSchoen.Avalonia.MainWindow"
        x:DataType="vm:SessionsViewModel"
        Title="MegaSchoen"
        Icon="/Assets/appicon.png"
        Width="900" Height="600">

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="20,8" BorderBrush="#40808080" BorderThickness="0,1,0,0">
            <CheckBox x:Name="AutostartToggle"
                      Content="Start on login (hidden in tray)"
                      FontSize="12"/>
        </Border>
        <TabControl>
            <TabItem Header="Claude Sessions">
                <ScrollViewer>
                    <StackPanel Margin="20" Spacing="12">

            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="Active Claude sessions"
                           FontSize="22"
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        VerticalAlignment="Center"/>
            </Grid>

            <ItemsControl ItemsSource="{Binding HostStatuses}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:HostStatusViewModel">
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,1">
                            <TextBlock Text="●" Foreground="{Binding StatusBrush}" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Host}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="Gray" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="No active Claude sessions"
                       IsVisible="{Binding HasNoSessions}"
                       Foreground="Gray"
                       HorizontalAlignment="Center"
                       Margin="20"/>

            <ItemsControl ItemsSource="{Binding Sessions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SessionCardViewModel">
                        <Border Margin="0,4" Padding="12"
                                BorderBrush="#40808080" BorderThickness="1" CornerRadius="6">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding Title}"
                                           IsVisible="{Binding HasTitle}"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           TextTrimming="CharacterEllipsis"/>
                                <Grid ColumnDefinitions="150,*,Auto,Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StateEmoji}" FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding StateText}"
                                                   Foreground="{Binding StateBrush}"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding CwdShort}"
                                               VerticalAlignment="Center"
                                               FontSize="13"
                                               Margin="10,0"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding LastActivityRelative}"
                                               Foreground="Gray"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Button Content="Copy path"
                                                IsVisible="{Binding HasTranscriptPath}"
                                                Command="{Binding $parent[Window].((vm:SessionsViewModel)DataContext).CopyTranscriptPathCommand}"
                                                CommandParameter="{Binding}"/>
                                        <Button Content="Focus"
                                                IsVisible="{Binding FocusButtonVisible}"
                                                IsEnabled="{Binding CanFocus}"
                                                Command="{Binding $parent[Window].((vm:SessionsViewModel)DataContext).FocusCommand}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding SessionIdStem}" FontSize="11" Foreground="Gray"/>
                                    <TextBlock Text="{Binding HostLabel}"
                                               IsVisible="{Binding HasHostLabel}"
                                               FontSize="11"
                                               Foreground="Gray"/>
                                </StackPanel>
                                <TextBlock Text="{Binding SubagentSummary}"
                                           IsVisible="{Binding HasSubagents}"
                                           FontSize="11"
                                           Foreground="Gray"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="DisplayManagerTab"
                     Header="Display Manager"
                     IsVisible="False">
                <views:DisplayManagerPage/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
