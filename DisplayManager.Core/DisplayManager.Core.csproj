<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- dotnet's Core MSBuild cannot load C++ .vcxproj targets. Full Visual Studio
       MSBuild keeps this build dependency, while dotnet builds compile the
       managed P/Invoke wrapper without attempting to produce a Windows DLL. -->
  <ItemGroup Condition="'$(MSBuildRuntimeType)' != 'Core'">
    <ProjectReference Include="..\DisplayManagerNative\DisplayManagerNative.vcxproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

  <Target Name="CopyDisplayManagerNative" AfterTargets="Build">
    <ItemGroup>
      <_NativeArtifact Include="..\DisplayManagerNative\bin\x64\$(Configuration)\DisplayManagerNative.dll" />
      <_NativeArtifact Include="..\DisplayManagerNative\bin\x64\$(Configuration)\DisplayManagerNative.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(_NativeArtifact)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" Condition="Exists('%(FullPath)')" />
  </Target>

</Project>
